# ==============================================================================
# LOGIX ENTERPRISE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# NOTE: Never commit real credentials. All secrets must be provided via environment.
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=LogixEnterprise
TZ=UTC

# API Gateway Configuration
GATEWAY_PORT=4000
GATEWAY_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Service Ports
AUTH_SERVICE_PORT=4001
ORDER_SERVICE_PORT=4002
INVENTORY_SERVICE_PORT=4003
LOGISTICS_SERVICE_PORT=4004
BILLING_SERVICE_PORT=4005
NOTIFICATION_SERVICE_PORT=4006
ANALYTICS_SERVICE_PORT=4007
WEB_DASHBOARD_PORT=3000

# Inter-Service Internal Endpoints
AUTH_SERVICE_URL=http://localhost:4001
ORDER_SERVICE_URL=http://localhost:4002
INVENTORY_SERVICE_URL=http://localhost:4003
LOGISTICS_SERVICE_URL=http://localhost:4004
BILLING_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
ANALYTICS_SERVICE_URL=http://localhost:4007

# JWT & Authentication
JWT_ACCESS_SECRET=replace_with_secure_random_access_secret_in_production
JWT_REFRESH_SECRET=replace_with_secure_random_refresh_secret_in_production
JWT_ACCESS_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=604800s
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# Databases Per Service
AUTH_DB_URL=postgresql://postgres:postgres_password@localhost:5432/logix_auth?schema=public
ORDER_DB_URL=postgresql://postgres:postgres_password@localhost:5433/logix_order?schema=public
INVENTORY_DB_URL=mongodb://localhost:27017/logix_inventory
LOGISTICS_DB_URL=postgresql://postgres:postgres_password@localhost:5434/logix_logistics?schema=public
BILLING_DB_URL=postgresql://postgres:postgres_password@localhost:5435/logix_billing?schema=public
ANALYTICS_DB_URL=postgresql://postgres:postgres_password@localhost:5436/logix_analytics?schema=public

# Message Broker & Distributed Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=logix.events.topic

# Telemetry & Observability
ENABLE_METRICS=true
METRICS_PORT=9090
TRACING_SERVICE_NAME=logix-platform

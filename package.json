{
  "name": "logix-monorepo",
  "version": "1.0.0",
  "description": "Enterprise Cloud-Native Supply Chain, Inventory & Fleet Logistics Microservices Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:common && npm run build:services && npm run build:apps",
    "build:common": "npm run --workspace=packages/common build",
    "build:services": "npm run --workspaces --if-present build",
    "build:apps": "npm run --workspace=apps/web-dashboard build",
    "start": "docker compose up --build",
    "start:dev": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:order\" \"npm run dev:inventory\" \"npm run dev:logistics\" \"npm run dev:billing\" \"npm run dev:notification\" \"npm run dev:analytics\" \"npm run dev:web\"",
    "dev:gateway": "npm run --workspace=services/api-gateway dev",
    "dev:auth": "npm run --workspace=services/auth-service dev",
    "dev:order": "npm run --workspace=services/order-service dev",
    "dev:inventory": "npm run --workspace=services/inventory-service dev",
    "dev:logistics": "npm run --workspace=services/logistics-service dev",
    "dev:billing": "npm run --workspace=services/billing-service dev",
    "dev:notification": "npm run --workspace=services/notification-service dev",
    "dev:analytics": "npm run --workspace=services/analytics-service dev",
    "dev:web": "npm run --workspace=apps/web-dashboard dev",
    "lint": "eslint \"{packages,services,apps,tests}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{packages,services,apps,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:e2e": "jest --config=jest.e2e.config.js --runInBand --forceExit",
    "clean": "rimraf node_modules packages/*/dist services/*/dist apps/*/dist coverage"
  },
  "keywords": [
    "microservices",
    "supply-chain",
    "logistics",
    "distributed-systems",
    "event-driven",
    "saga-pattern",
    "clean-architecture",
    "typescript",
    "react"
  ],
  "author": "Logix Core Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
